# 后端选择：python（默认，使用现有 Python 服务）或 go（运行 bin/ 中的预编译 Go 服务）。
# GO_BACKEND=python

# SQLite 数据库文件路径。相对路径以项目根目录为基准，也可以填写绝对路径。
DATABASE_PATH=data/options.db

# Web 服务监听地址。0.0.0.0 表示允许本机和局域网访问；仅本机访问可填写 127.0.0.1。
HOST=0.0.0.0

# Web 服务监听端口。填写 1024-65535 之间的未占用端口，例如 8000。
PORT=8000

# 页面与 API 的访问密钥。run.sh 首次启动时会自动生成 16 位小写字母 + 数字并写入本文件。
# 访问地址格式：http://服务器地址:端口/?key=生成的密钥
# 页面导航和 AJAX 请求都会在 URL 上携带 key；浏览器同时写入 localStorage 作为备用来源。
# 留空表示不启用访问保护，仅建议本机临时调试使用；生产环境和局域网部署请保持非空。
ACCESS_KEY=

# Go 后端的出站行情接口请求代理地址。留空表示不使用代理。
# 支持 http、https、socks5 和 socks5h。示例：http://127.0.0.1:10808
MARKET_PROXY=

# Alpaca Basic (https://app.alpaca.markets/signup) 夜盘股票行情（只读取现货，不使用期权 indicative feed）。
ALPACA_API_KEY=
ALPACA_API_SECRET=

# 默认页面标的。兼容旧版逗号分隔值，默认使用第一项；不触发行情后台刷新。
DEFAULT_SYMBOLS=QQQ

# SQLite 数据库体积上限。填纯数字即按 MB 解释，也支持 300M、1G 这类写法；0 表示不限制。
# 数据库体积超过上限后，后台维护任务每天检查并按阶梯清理历史数据：
# 先清空冗余报文列，再把被新快照覆盖的旧批次按「天」「小时」逐级瘦身，最后回收磁盘文件。
# 0 表示不限制体积，适合磁盘充裕的环境。
# 小磁盘环境的填写建议：LXC 容器给 512M 磁盘填 200-300，给 1G 磁盘填 500-600；
# 建议不超过磁盘总容量的 60%，为 SQLite 回收文件时的临时文件和日志留出空间。
DATABASE_MAX_MB=256M

# 历史行情和期权快照保留天数。Python 定时维护会按此设置清理；Go 版 /api/cleanup 使用同一设置。
RAW_RETENTION_DAYS=7

# 日线历史行情的回源间隔，单位为秒。压力位/支撑位的斐波那契、筹码分布与承接位依赖日线数据，
# 3600 表示最多每小时向上游重新抓取一次，其余请求复用 SQLite 缓存。
HISTORY_MAX_AGE_SECONDS=3600

# 52 周最高/最低与历史最高/最低价（趋势通道面板）的回源间隔，单位为秒。
# 这两组极值需要抓取全量日线，数据一天内基本不变，86400 表示每天最多回源一次；
# 抓取失败时该面板不显示极值行，不影响压力位/支撑位等其他数据。
EXTREMES_MAX_AGE_SECONDS=86400

# 是否启用定时历史清理和数据库维护。行情刷新仅针对活跃 SSE 连接标的。支持 true/false、1/0、yes/no、on/off。
SCHEDULER_ENABLED=true

# 单进程上游并发数。Go 支持 auto，按启动时可用内存和 CPU 动态计算；整数值作为并发上限。
# Python 版将 auto 视为原有默认并发数 6。
UPSTREAM_CONCURRENCY=auto

# Go only: request timeout per provider, matching Python's 12s Yahoo and 15s Cboe limits.
UPSTREAM_TIMEOUT_SECONDS=12
CBOE_TIMEOUT_SECONDS=15

# 上游请求等待并发槽位的最长时间；超时后优先沿用本地旧快照。
UPSTREAM_WAIT_SECONDS=20

# 低内存保护。Go 后端 auto 在内存上限不超过 4GiB 或可用内存不超过 2GiB 时自动开启：
# Go 低内存模式控制后台重任务并发、缩小缓存、单 worker；基础报价和到期日请求仍可在共享预算内并发。
# 低内存机器保持 auto 或 true；需要关闭保护时可显式设为 false。
LOW_MEMORY=auto

# Go GC 软内存上限：默认 auto，启动时检测物理内存与 cgroup v1/v2（含父级）上限，
# 以启动时可用内存和实际上限的较小值为预算，预留 20% 且至少 32MiB（极小预算最多留一半）。
# 支持手动 96MiB、512MiB、1GiB 或纯字节数；off 表示关闭软上限。Swap 不计入自动预算。
# Go 初始化缓存和 SQLite 前应用限制；直接运行、systemd、看门狗重启均生效。
# GO_MEMORY_LIMIT=auto 时也尊重显式的 GOMEMLIMIT；GOMEMLIMIT 本身不支持 auto。
GO_MEMORY_LIMIT=auto
